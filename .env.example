# Template for two files (both are git-ignored, never commit them):
#   .env        -> your CLOUD Supabase project (used to seed cloud logins)
#   .env.local  -> the LOCAL Docker Supabase from `npx supabase start`
# When both exist, .env.local wins (for npm run dev, npm run build and npm run seed:users).
# To seed the cloud while .env.local exists:  npm run seed:users -- --env .env

# ---------------------------------------------------------------
# Public values (end up in the browser)
#   local: API URL + "Publishable" key printed by `npx supabase status`
#   cloud: Project Settings > API keys (anon or publishable key)
#   Vercel: add these two under Project > Settings > Environment Variables
# ---------------------------------------------------------------
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=sb_publishable_xxx

# ---------------------------------------------------------------
# SECRET - only for `npm run seed:users` on your machine.
#   local: "Secret" key printed by `npx supabase status`
#   cloud: service_role or secret key
# Never prefix with VITE_, never add to Vercel.
# ---------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# ---------------------------------------------------------------
# Login accounts created by `npm run seed:users` (min. 6 characters)
# ---------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-please
SEED_ADMIN_NAME=Admin

# Optional extra logins: SEED_USER_<n>_EMAIL / _PASSWORD / _NAME / _ROLE (user|admin)
# SEED_USER_1_EMAIL=customer@example.com
# SEED_USER_1_PASSWORD=change-me-too
# SEED_USER_1_NAME=Test Customer
# SEED_USER_1_ROLE=user
