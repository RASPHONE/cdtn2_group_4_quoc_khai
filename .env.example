# Copy this file to .env and fill in your values. Never commit .env.
# Values come from: Supabase Dashboard > Project Settings > API keys

# ---------------------------------------------------------------
# Frontend (bundled into the browser app - public values only)
# Also add these two in Vercel > Project > Settings > Environment Variables
# ---------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# ---------------------------------------------------------------
# Seeding only (used by `npm run seed:users` on your machine)
# SECRET - do NOT prefix with VITE_ and do NOT add to Vercel
# ---------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Admin login (role = admin, can open /admin)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-please
SEED_ADMIN_NAME=Admin

# Optional extra logins: SEED_USER_<n>_EMAIL / _PASSWORD / _NAME / _ROLE
# ROLE is "user" (default) or "admin". Add as many as you need (1, 2, 3, ...).
# SEED_USER_1_EMAIL=customer@example.com
# SEED_USER_1_PASSWORD=change-me-too
# SEED_USER_1_NAME=Test Customer
# SEED_USER_1_ROLE=user
